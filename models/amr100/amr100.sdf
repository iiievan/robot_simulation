  <!-- PLUGINS -->
  <!--
  <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
    <joint_name>Drive_wheel_R_link_joint</joint_name>
    <use_force_commands>0</use_force_commands>
    <p_gain>20.00000</p_gain>
    <i_gain>0.00000</i_gain>
    <d_gain>0.00000</d_gain>
  </plugin>

  <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
    <joint_name>Drive_wheel_L_link_joint</joint_name>
    <use_force_commands>0</use_force_commands>
    <p_gain>20.00000</p_gain>
    <i_gain>0.00000</i_gain>
    <d_gain>0.00000</d_gain>
  </plugin>
  -->
  <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <left_joint>Drive_wheel_L_link_joint</left_joint>
      <right_joint>Drive_wheel_R_link_joint</right_joint>
      <wheel_separation>0.415</wheel_separation>
      <wheel_radius>0.0625</wheel_radius>
      <odom_publish_frequency>1</odom_publish_frequency>
      <topic>cmd_vel</topic>
  </plugin>

     <!-- Moving Forward 'W'-->
    <plugin filename="gz-sim-triggered-publisher-system"
            name="gz::sim::systems::TriggeredPublisher">
        <input type="gz.msgs.Int32" topic="/keyboard/keypress">
            <match field="data">87</match>
        </input>
        <output type="gz.msgs.Twist" topic="/cmd_vel">
            linear: {x: 0.0, y: 0.0, z: 0.0}, angular: {x: 0.0, y: 0.0, z: -3.0}
        </output>
    </plugin>

    <!-- Moving Backward 'D'-->
    <plugin filename="gz-sim-triggered-publisher-system"
            name="gz::sim::systems::TriggeredPublisher">
        <input type="gz.msgs.Int32" topic="/keyboard/keypress">
            <match field="data">83</match>
        </input>
        <output type="gz.msgs.Twist" topic="/cmd_vel">
            linear: {x: 0.0, y: 0.0, z: 0.0}, angular: {x: 0.0, y: 0.0, z: 3.0}
        </output>
    </plugin>

    <!-- Moving Left 'A'-->
    <plugin filename="gz-sim-triggered-publisher-system"
            name="gz::sim::systems::TriggeredPublisher">
        <input type="gz.msgs.Int32" topic="/keyboard/keypress">
            <match field="data">65</match>
        </input>
        <output type="gz.msgs.Twist" topic="/cmd_vel">
            linear: {x: -0.1, y: 0.0, z: 0.0}, angular: {x: 0.0, y: 0.0, z: 0.0}
        </output>
    </plugin>

    <!-- Moving Right 'D'-->
    <plugin filename="gz-sim-triggered-publisher-system"
            name="gz::sim::systems::TriggeredPublisher">
        <input type="gz.msgs.Int32" topic="/keyboard/keypress">
            <match field="data">68</match>
        </input>
        <output type="gz.msgs.Twist" topic="/cmd_vel">
            linear: {x: 0.1, y: 0.0, z: 0.0}, angular: {x: 0.0, y: 0.0, z: 0.0}
        </output>
    </plugin>

    <!-- Encoder Plugin -->
    <plugin name="gz::sim::v10::systems::EncoderPlugin" filename="libencoder_plugin.so">
      <left_joint>Drive_wheel_L_link_joint</left_joint>
      <right_joint>Drive_wheel_R_link_joint</right_joint>
      <topic>/encoder_data</topic>
      <ticks_per_rev>10000</ticks_per_rev>
    </plugin>

</model>
</sdf>